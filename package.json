{
  "name": "sdk-orchestrator",
  "version": "0.1.0",
  "description": "SLE (Sustained Learning Engine) - SDK orchestration system",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "stratum": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:watch": "node --import tsx --watch --test tests/*.test.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "js-yaml": "^4.1.0",
    "ws": "^8.21.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "sle",
    "orchestration",
    "development-automation"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
