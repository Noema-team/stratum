{
  "name": "sdk-orchestrator",
  "version": "0.1.0",
  "description": "SLE (Sustained Learning Engine) - SDK orchestration system",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test tests/types.test.ts tests/runtime-map.test.ts tests/state-machine.test.ts",
    "test:watch": "node --import tsx --watch --test tests/types.test.ts tests/runtime-map.test.ts tests/state-machine.test.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^20.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "sle",
    "orchestration",
    "development-automation"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
